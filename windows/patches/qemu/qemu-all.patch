+/*
+ * With WHPX's in-hypervisor APIC, QEMU's APIC never reports a delivery, so every
+ * tick would look lost and be injected again without end: XP's clock ran 16x fast.
+ * There, go by what the guest did: a tick is missed if it has not yet acknowledged
+ * the one before, which it does by reading register C.
+ */
+static bool rtc_policy_slew_deliver_irq(MC146818RtcState *s, bool unacked)
 {
     kvm_reset_irq_delivered();
     qemu_irq_raise(s->irq);
+    if (whpx_irqchip_in_kernel()) {
+        return !unacked;
+    }
     return kvm_get_irq_delivered();
 }
 
